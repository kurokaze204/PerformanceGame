# DATABASE_URL: PostgreSQL / Neon connection string.
# Required for persistent game history, AAR evidence and cross-game benchmarking.
# Example: postgresql://user:password@ep-xyz.neon.tech/performance_gap?sslmode=require
DATABASE_URL=

# FACILITATOR_SECRET: Required for facilitator/destructive controls.
# Choose a strong passcode for test and production environments. There is no built-in fallback password.
FACILITATOR_SECRET=

# SESSION_SECRET: Reserved for signed participant/session authorization hardening.
SESSION_SECRET=

# APP_URL: Optional deployed application base URL.
APP_URL=

# GEMINI_API_KEY: Optional. Runtime AI is not required for the simulation or AAR evidence.
GEMINI_API_KEY=
