# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL / Neon Database connection string.
# Obtained directly from your Neon dashboard (e.g. postgresql://user:password@ep-xyz.neon.tech/performance_gap?sslmode=require).
# Note: Neon ONLY supplies this database connection string. It does not provide the application secrets below.
# If left empty, the application automatically runs with high-performance in-memory persistence.
DATABASE_URL=

# SESSION_SECRET: [OPTIONAL] A custom secret string used internally by the app to sign participant tokens/sessions.
# You can invent any random passphrase here (e.g. "my-custom-secret-key-98765"), or leave it completely blank.
SESSION_SECRET=

# FACILITATOR_SECRET: [OPTIONAL] The master admin passcode to lock the Facilitator Command Dashboard.
# You choose your own password here (e.g. "mySecretPasscode123").
# If left blank, it defaults to "facilitator2026".
FACILITATOR_SECRET=

