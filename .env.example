# DATABASE_URL: PostgreSQL / Neon connection string.
# Example: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# Development can run in-memory when this is blank. Production should use Neon.
DATABASE_URL=

# APP_URL: Public URL of the deployed application.
APP_URL=

# SESSION_SECRET: Reserved for signed participant/session tokens in a later hardening pass.
SESSION_SECRET=

# FACILITATOR_SECRET: REQUIRED before facilitator/destructive controls can be used.
# Choose a strong workshop-admin passcode. There is deliberately no built-in default.
FACILITATOR_SECRET=

# Runtime AI is not required by The Performance Gap V1.
# If an optional AI debrief is added later, its API key should be server-side only.
